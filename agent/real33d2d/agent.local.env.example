# Template for agent/real33d2d/agent.local.env, which is gitignored and holds
# only local deployment paths. Copy it, fill it in, and never add credential
# values to it: the launchers read the account and password straight out of the
# prepared QA runtime's own secrets file at launch time and keep them in the
# child process environment only.

# Where the REAL33D2D checkout with the built client lives.
R33D_CLIENT_ROOT=

# WSL distribution hosting the prepared Fusion32 QA runtime.
R33D_WSL_DISTRO=

# Path, inside that distribution, of the QA runtime's generated secrets file.
# The file itself is produced by scripts/server/prepare_wsl.sh and never leaves
# the runtime directory.
R33D_QA_CREDENTIALS=

# Which prepared QA character to log in as. No character is special-cased in
# any tracked file; this is a local choice.
R33D_QA_CHARACTER=

# Where the JSONL trace is written for a bridge run.
R33D_AGENT_TRACE=
