Module
  name: real33d_agent
  description: Opt-in REAL33D 2D agent bridge (observation, validated intents, JSONL trace)
  author: REAL33D
  autoload: true
  autoload-priority: 1300
  reloadable: false
  sandboxed: false
  scripts: [ agent_schema, agent_memory, agent_core, agent_bridge, agent_runtime ]
  @onLoad: Real33DAgentRuntime.init()
  @onUnload: Real33DAgentRuntime.terminate()
