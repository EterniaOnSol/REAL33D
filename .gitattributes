# Preserve upstream reference bytes across Windows checkouts.
/reference/** text eol=lf
/tests/*.sh text eol=lf

# Seeded character save files. Game writes these with LF and reads them back
# itself, so a Windows checkout must not hand it CRLF.
/tests/fixtures/usr/*.usr text eol=lf
/evidence/build/*.log text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Generated manifests and the visual tracker stay in plain Git so they remain
# diffable and reviewable.
/visual/manifests/*.csv text eol=lf
/visual/manifests/*.json text eol=lf
/visual/tracker/*.csv text eol=lf
/visual/rookgaard_p0/*.csv text eol=lf
*.py text eol=lf

# Visual binaries go to Git LFS. See visual/docs/PIPELINE.md. These entries are
# inert until `git lfs install` has been run in a clone, and no binary asset is
# committed yet, so declaring them now costs nothing and avoids a later history
# rewrite.
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
