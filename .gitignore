# Retain these pre-existing archives locally; never stage them by default.
/game-3fd1bdbaaffc6582943e3c9b3c28c20976fcb2ad.tar.gz
/game-3fd1bdbaaffc6582943e3c9b3c28c20976fcb2ad.zip
/game-db5050d5dbc0525d05837f728bea52f7954286cc.tar.gz
/game-db5050d5dbc0525d05837f728bea52f7954286cc.zip
/game-master.tar.gz
/game-master.zip
/tibia-game.tarball.tar.gz
/tibiacacaca.zip

# Never track wholesale legacy runtime extraction or audit scratch data.
/runtime-legacy/
/reference/runtime/
/runtime/
/.audit/
/.agents/

# Generated runtime secrets/configuration. Distribution templates remain tracked.
*.pem
*.key
**/config.cfg

# The reference pack is derived from the client's Tibia.dat and Tibia.spr,
# whose provenance is recorded as UNKNOWN. Previews are derivative works of
# that artifact, so the pack is rebuilt locally and never published. See
# visual/docs/REFERENCE_PACK.md for the one-command rebuild.
/visual/reference_pack/

__pycache__/
*.pyc

# Authoring scratch that must never be committed, not even through LFS.
*.blend1
*.blend2
/visual/**/cache/
/visual/**/bake/
/visual/**/*.autosave

# Generated output.
/build/

# A mistyped cmake invocation configures into a directory named after the
# argument it failed to parse, which lands outside /build/ and is not ignored by
# anything above. These two names are CMake's own and appear only in a configure
# tree, so matching them catches a stray build wherever it is created without
# ignoring anything a person would write.
CMakeCache.txt
CMakeFiles/
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Unreal generates these beside the project, not at the repository root, so the
# anchored rules above do not reach them.
/unreal/**/Binaries/
/unreal/**/Build/
/unreal/**/DerivedDataCache/
/unreal/**/Intermediate/
/unreal/**/Saved/
/unreal/**/*.sln
/unreal/**/.vs/
/unreal/**/.vscode/
/unreal/**/.idea/

# Local-only output of VISUAL-FULL-CATALOG-INGEST-TEST-001. The text manifest,
# scripts and reports remain reviewable; thousands of experimental .uasset
# files stay outside Git until their LFS cost receives separate approval.
/unreal/REAL33D/Content/Experimental/V08/

# Item pictures cut out of Tibia.dat/Tibia.spr by
# scripts/client/extract_item_sprites.py. That pair is CipSoft's client data,
# so the sprites derived from it are theirs too and do not belong in this
# repository whoever can read it. The extractor is committed and the runtime
# looks these up by type id, so a clone regenerates them in one command from
# its own local copy of the data; without them the panels fall back to showing
# the object's numeric type id, which is still exactly what the server sent.
/unreal/REAL33D/Resources/UI/Items/
